 	// runs on non-RT, can block or use [de]allocations
+	void Plugin::drain_retired() noexcept
+	{
+		int n = 0;
+		for (int i = 0; i < kRetiredSlots; i++)
+		{
+			NeuralAudio::NeuralModel* m = retired[i].exchange(nullptr);
+			if (m != nullptr) { delete m; n++; }
+		}
+		if (n > 0)
+			lv2_log_trace(&logger, "golem: %d retired model(s) freed by the worker\n", n);
+	}
